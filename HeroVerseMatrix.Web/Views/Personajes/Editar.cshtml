@model HeroVerseMatrix.Web.ViewModels.Personajes.EditarPersonajeFormModel

@{
    ViewBag.Title = "Editar personaje";
    var sinCasas = Model.CasaMatrizOptions == null || !Model.CasaMatrizOptions.Any();
}

<div class="page-header">
    <h1 class="h2">Editar personaje</h1>
</div>

<div class="card card-heroverse form-heroverse">
    <div class="card-body p-4">
        @using (Html.BeginForm("Editar", "Personajes", new { id = Model.Id }, FormMethod.Post))
        {
            @Html.AntiForgeryToken()
            @Html.HiddenFor(m => m.Id)
            @Html.ValidationSummary(true, "", new { @class = "alert alert-danger" })

            @Html.Partial("_CamposPersonaje", Model)

            <div class="d-flex flex-wrap gap-2">
                <button type="submit" class="btn btn-primary" @(sinCasas ? "disabled" : "")>Guardar cambios</button>
                @Html.ActionLink("Cancelar", "Detalle", new { id = Model.Id }, new { @class = "btn btn-secondary" })
            </div>
        }
    </div>
</div>

@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
}
