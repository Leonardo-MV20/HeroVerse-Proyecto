

@model IEnumerable<HeroVerseMatrix.Web.ViewModels.Personajes.PersonajeViewModel>
@{ ViewBag.Title = "Personajes"; }

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2>Personajes</h2>
    @Html.ActionLink("Nuevo personaje", "Crear", null, new { @class = "btn btn-primary" })
</div>

@if (TempData["Exito"] != null)
{<div class="alert alert-success">@TempData["Exito"]</div>}
@if (TempData["Error"] != null)
{<div class="alert alert-danger">@TempData["Error"]</div>}

<table class="table table-striped table-hover">
    <thead><tr><th>Nombre</th><th>Casa matriz</th><th>Tipo</th><th>Acciones</th></tr></thead>
    <tbody>
        @foreach (var personaje in Model)
        {
            <tr>
                <td>@personaje.Nombre</td>
                <td>@personaje.CasaMatriz</td>
                <td>@(personaje.EsHeroe ? "Héroe" : "Villano")</td>
                <td>
                    @Html.ActionLink("Ver", "Detalle", new { id = personaje.Id }, new { @class = "btn btn-sm btn-info" })
                    @Html.ActionLink("Editar", "Editar", new { id = personaje.Id }, new { @class = "btn btn-sm btn-warning" })
                    @Html.ActionLink("Eliminar", "Eliminar", new { id = personaje.Id }, new { @class = "btn btn-sm btn-danger" })
                </td>
            </tr>
        }
    </tbody>
</table>
@if (!Model.Any())
{<div class="alert alert-info">Aún no hay personajes registrados.</div>}
