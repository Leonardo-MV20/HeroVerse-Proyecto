@model IEnumerable<HeroVerseMatrix.Web.ViewModels.Personajes.PersonajeViewModel>

@{
    ViewBag.Title = "Personajes";
}

<div class="page-header">
    <h1 class="h2">Personajes</h1>
    @Html.ActionLink("Nuevo personaje", "Crear", null, new { @class = "btn btn-primary" })
</div>

@if (!Model.Any())
{
    @Html.Partial("_EstadoVacio", new ViewDataDictionary {
        { "Titulo", "Aun no hay personajes registrados" },
        { "Mensaje", "Cree el primer personaje para empezar a poblar el universo." },
        { "AccionTexto", "Nuevo personaje" },
        { "Accion", "Crear" },
        { "Controlador", "Personajes" }
    })
}
else
{
    <div class="card card-heroverse">
        <div class="table-responsive">
            <table class="table table-hover table-heroverse mb-0">
                <thead>
                    <tr>
                        <th>Nombre</th>
                        <th>Alter ego</th>
                        <th>Casa matriz</th>
                        <th>Tipo</th>
                        <th class="text-end">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var personaje in Model)
                    {
                        <tr>
                            <td class="fw-semibold">@personaje.Nombre</td>
                            <td>@personaje.AlterEgo</td>
                            <td>@personaje.CasaMatriz</td>
                            <td>
                                <span class="badge @(personaje.EsHeroe ? "badge-heroe" : "badge-villano")">
                                    @(personaje.EsHeroe ? "heroe" : "Villano")
                                </span>
                            </td>
                            <td class="text-end acciones">
                                @Html.ActionLink("Ver", "Detalle", new { id = personaje.Id }, new { @class = "btn btn-sm btn-outline-primary" })
                                @Html.ActionLink("Editar", "Editar", new { id = personaje.Id }, new { @class = "btn btn-sm btn-outline-secondary" })
                                @Html.ActionLink("Eliminar", "Eliminar", new { id = personaje.Id }, new { @class = "btn btn-sm btn-outline-danger" })
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}
