@model HeroVerseMatrix.Web.ViewModels.Personajes.PersonajeViewModel

@{
    ViewBag.Title = "Detalle del personaje";
}

<div class="page-header">
    <h1 class="h2">Detalle del personaje</h1>
</div>

<div class="card card-heroverse form-heroverse">
    <div class="card-body p-4">
        <dl class="row detalle mb-4">
            <dt class="col-sm-4">Nombre</dt>
            <dd class="col-sm-8">@Model.Nombre</dd>

            <dt class="col-sm-4">Alter ego</dt>
            <dd class="col-sm-8">@Model.AlterEgo</dd>

            <dt class="col-sm-4">Casa matriz</dt>
            <dd class="col-sm-8">@Model.CasaMatriz</dd>

            <dt class="col-sm-4">Tipo</dt>
            <dd class="col-sm-8">
                <span class="badge @(Model.EsHeroe ? "badge-heroe" : "badge-villano")">
                    @(Model.EsHeroe ? "heroe" : "Villano")
                </span>
            </dd>
        </dl>

        <div class="d-flex flex-wrap gap-2">
            @Html.ActionLink("Editar", "Editar", new { id = Model.Id }, new { @class = "btn btn-primary" })
            @Html.ActionLink("Eliminar", "Eliminar", new { id = Model.Id }, new { @class = "btn btn-outline-danger" })
            @Html.ActionLink("Volver", "Index", null, new { @class = "btn btn-secondary" })
        </div>
    </div>
</div>
