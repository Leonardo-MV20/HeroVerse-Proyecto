@model HeroVerseMatrix.Web.ViewModels.Personajes.CrearPersonajeFormModel

@{
    ViewBag.Title = "Nuevo personaje";
    var sinCasas = Model.CasaMatrizOptions == null || !Model.CasaMatrizOptions.Any();
}

<div class="page-header">
    <h1 class="h2">Nuevo personaje</h1>
</div>

<div class="card card-heroverse form-heroverse">
    <div class="card-body p-4">
        @using (Html.BeginForm("Crear", "Personajes", FormMethod.Post))
        {
            @Html.AntiForgeryToken()
            @Html.ValidationSummary(true, "", new { @class = "alert alert-danger" })

            @Html.Partial("_CamposPersonaje", Model)

            <div class="d-flex flex-wrap gap-2">
                <button type="submit" class="btn btn-primary" @(sinCasas ? "disabled" : "")>Guardar</button>
                @Html.ActionLink("Cancelar", "Index", null, new { @class = "btn btn-secondary" })
            </div>
        }
    </div>
</div>

@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
}
