@model IEnumerable<HeroVerseMatrix.Web.ViewModels.CasaMatrix.CasaMatrixViewModel>

@{
    ViewBag.Title = "Casas Matrix";
}

<div class="page-header">
    <h1 class="h2">Casas Matrix</h1>
    @Html.ActionLink("Nueva Casa Matrix", "Crear", null, new { @class = "btn btn-primary" })
</div>

@if (!Model.Any())
{
    @Html.Partial("_EstadoVacio", new ViewDataDictionary {
        { "Titulo", "Aun no hay casas matrices registradas" },
        { "Mensaje", "Cree la primera casa matriz para poder asignarle personajes." },
        { "AccionTexto", "Nueva Casa Matrix" },
        { "Accion", "Crear" },
        { "Controlador", "CasaMatrices" }
    })
}
else
{
    <div class="card card-heroverse">
        <div class="table-responsive">
            <table class="table table-hover table-heroverse mb-0">
                <thead>
                    <tr>
                        <th>Nombre</th>
                        <th>descripcion</th>
                        <th class="text-end">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td class="fw-semibold">@Html.DisplayFor(modelItem => item.Nombre)</td>
                            <td>@Html.DisplayFor(modelItem => item.Descripcion)</td>
                            <td class="text-end acciones">
                                @Html.ActionLink("Detalles", "Detalle", new { id = item.Id }, new { @class = "btn btn-sm btn-outline-primary" })
                                @Html.ActionLink("Editar", "Editar", new { id = item.Id }, new { @class = "btn btn-sm btn-outline-secondary" })
                                @Html.ActionLink("Eliminar", "Eliminar", new { id = item.Id }, new { @class = "btn btn-sm btn-outline-danger" })
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}
