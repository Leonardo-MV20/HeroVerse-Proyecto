
@model HeroVerseMatrix.Web.ViewModels.CasaMatrix.CasaMatrixDetalleViewModel

@{
    ViewBag.Title = "Eliminar Casa Matrix";
}

<h2>Eliminar Casa Matrix</h2>

<h3>¿Está seguro que desea eliminar esta Casa Matrix?</h3>

<div>
    <hr />

    <dl class="dl-horizontal">
        <dt>
            @Html.DisplayNameFor(model => model.Nombre)
        </dt>

        <dd>
            @Html.DisplayFor(model => model.Nombre)
        </dd>

        <dt>
            @Html.DisplayNameFor(model => model.Descripcion)
        </dt>

        <dd>
            @Html.DisplayFor(model => model.Descripcion)
        </dd>
    </dl>

    @using (Html.BeginForm("ConfirmarEliminar", "CasaMatrices", FormMethod.Post))
    {
        @Html.AntiForgeryToken()
        @Html.HiddenFor(model => model.Id)

        <button type="submit" class="btn btn-danger">
            Eliminar
        </button>

        @Html.ActionLink(
            "Cancelar",
            "Index",
            null,
            new { @class = "btn btn-default" }
        )
    }
</div>