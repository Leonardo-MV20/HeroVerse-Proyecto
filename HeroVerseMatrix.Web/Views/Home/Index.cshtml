@{
    ViewBag.Title = "Inicio";
}

<section class="p-4 p-md-5 mb-4 text-white rounded-3 navbar-heroverse">
    <h1 class="display-5 fw-bold">HeroVerse Matrix</h1>
    <p class="lead mb-0">
        Administre las casas matrices y los personajes del universo: heroes, villanos y sus alter egos.
    </p>
</section>

<div class="row g-4">
    <section class="col-md-6" aria-labelledby="tituloCasas">
        <div class="card card-heroverse h-100">
            <div class="card-body p-4 d-flex flex-column">
                <h2 id="tituloCasas" class="h4">Casas Matrix</h2>
                <p class="text-muted flex-grow-1">
                    Registre, consulte y organice las casas matrices a las que pertenecen los personajes.
                </p>
                <div>
                    @Html.ActionLink("Ver casas matrix", "Index", "CasaMatrices", null, new { @class = "btn btn-primary" })
                </div>
            </div>
        </div>
    </section>

    <section class="col-md-6" aria-labelledby="tituloPersonajes">
        <div class="card card-heroverse h-100">
            <div class="card-body p-4 d-flex flex-column">
                <h2 id="tituloPersonajes" class="h4">Personajes</h2>
                <p class="text-muted flex-grow-1">
                    Cree y edite personajes, asígnelos a una casa matriz y defina si son heroes o villanos.
                </p>
                <div>
                    @Html.ActionLink("Ver personajes", "Index", "Personajes", null, new { @class = "btn btn-primary" })
                </div>
            </div>
        </div>
    </section>
</div>
