@{
    var controlador = (ViewContext.RouteData.Values["controller"] ?? "").ToString();
    Func<string, string> activo = c =>
        string.Equals(controlador, c, StringComparison.OrdinalIgnoreCase) ? " active" : "";
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewBag.Title - HeroVerse Matrix</title>
    @Styles.Render("~/Content/css")
    @Scripts.Render("~/bundles/modernizr")
</head>
<body class="d-flex flex-column min-vh-100">
    <nav class="navbar navbar-expand-md navbar-dark navbar-heroverse">
        <div class="container">
            @Html.ActionLink("HeroVerse Matrix", "Index", "Home", new { area = "" }, new { @class = "navbar-brand fw-bold" })
            <button type="button" class="navbar-toggler" data-bs-toggle="collapse" data-bs-target="#menuPrincipal"
                    aria-controls="menuPrincipal" aria-expanded="false" aria-label="Mostrar u ocultar el menú">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="menuPrincipal">
                <ul class="navbar-nav me-auto mb-2 mb-md-0">
                    <li class="nav-item">
                        @Html.ActionLink("Inicio", "Index", "Home", new { area = "" }, new { @class = "nav-link" + activo("Home") })
                    </li>
                    <li class="nav-item">
                        @Html.ActionLink("Casas Matrix", "Index", "CasaMatrices", new { area = "" }, new { @class = "nav-link" + activo("CasaMatrices") })
                    </li>
                    <li class="nav-item">
                        @Html.ActionLink("Personajes", "Index", "Personajes", new { area = "" }, new { @class = "nav-link" + activo("Personajes") })
                    </li>
                </ul>
            </div>
        </div>
    </nav>

    <main class="container flex-grow-1 body-content py-4">
        @Html.Partial("_Alertas")
        @RenderBody()
    </main>

    <footer class="footer-heroverse py-3 mt-auto">
        <div class="container text-center text-muted small">
            &copy; @DateTime.Now.Year - HeroVerse Matrix
        </div>
    </footer>

    @Scripts.Render("~/bundles/jquery")
    @Scripts.Render("~/bundles/bootstrap")
    @RenderSection("scripts", required: false)
</body>
</html>
